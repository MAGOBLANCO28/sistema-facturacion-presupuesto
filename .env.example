# ── BASE DE DATOS ──────────────────────────────────────
DATABASE_URL="postgresql://usuario:contraseña@host:5432/faktio"

# ── AUTENTICACIÓN ──────────────────────────────────────
JWT_SECRET="cambia_esto_por_una_clave_secreta_larga"

# ── IA (GEMINI) ────────────────────────────────────────
# AI Studio inyecta esto automáticamente desde los secretos del usuario
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ── URL DE LA APLICACIÓN ───────────────────────────────
APP_URL="https://faktiopro.com"

# ── SMTP — AGENTES IA (Recordatorios de Cobros e Impuestos) ──
# Proveedor Gmail:  SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURE=false
# Proveedor Outlook: SMTP_HOST=smtp.office365.com  SMTP_PORT=587
# Proveedor Resend: SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_SECURE=true
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="tu@gmail.com"
SMTP_PASS="tu_contraseña_de_aplicacion"
SMTP_FROM="Faktio Pro <tu@gmail.com>"

# ── ENTORNO ────────────────────────────────────────────
PORT="7860"
NODE_ENV="production"
